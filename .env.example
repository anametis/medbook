# Set HOST=0.0.0.0 to serve a candidate on the LAN.
HOST=127.0.0.1
PORT=3001
DB_PATH=./data/medibook.sqlite

# These are the browser origins of the candidate's React development server.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

LATENCY_MS=300
SIMULATION_MODE=normal
SIMULATION_OPERATION=
