{
  "name": "medibook-mock-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=26.12.0 <27" },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.ts",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "db:reset": "node --env-file-if-exists=.env src/db-cli.ts reset",
    "db:seed": "node --env-file-if-exists=.env src/db-cli.ts seed"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/swagger": "^9.0.0",
    "@fastify/swagger-ui": "^5.0.0",
    "fastify": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.7",
    "typescript": "^6.0.0"
  }
}
